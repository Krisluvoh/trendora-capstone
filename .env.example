# Copy this file to .env and fill in the provider(s) you want to use.
# Trendora runs with zero keys via the built-in MockClient (TRENDORA_PROVIDER=mock, the default).

# Which provider main.py should use: anthropic | openai | groq | mock
TRENDORA_PROVIDER=mock

# Claude (default real provider)
ANTHROPIC_API_KEY=

# OpenAI (optional alternative provider)
OPENAI_API_KEY=

# Groq (optional free-tier alternative, via langchain-groq)
GROQ_API_KEY=
